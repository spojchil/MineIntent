# Minecraft 1.21.1 连接
MINEINTENT_WORLD_ID=local-paper
MINEINTENT_MC_HOST=127.0.0.1
MINEINTENT_MC_PORT=25565
MINEINTENT_MC_USERNAME=MineIntentBot
MINEINTENT_MC_AUTH=offline
# Microsoft 登录可按需取消下一行注释并指定独立资料目录。
# MINEINTENT_MC_PROFILES_FOLDER=.mineintent/minecraft-profiles

# 以下两项是当前实现仍要求的兼容配置；已知偏差见 docs/architecture.md。
MINEINTENT_PRIMARY_PLAYER=你的游戏名
MINEINTENT_PROFILE=companion-profile.md

# 持久数据和只读本地调试接口
MINEINTENT_DATA_DIR=.mineintent
MINEINTENT_DEBUG_PORT=3211

# agent-service（Python）监听地址；Node 侧决策请求发到这里
MINEINTENT_AGENT_SERVICE_URL=http://127.0.0.1:8765
# Node 与 Python 之间的独立本地认证令牌。请用密码学安全随机值替换，至少 32 字符；不得复用模型 API key。
# 示例生成命令：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MINEINTENT_AGENT_SERVICE_TOKEN=替换为独立生成的本地随机令牌_至少32字符

# 以下模型配置只被 agent-service/server.py 读取，Node 进程不使用
# 支持 tools/tool_calls 的 OpenAI-compatible Chat Completions 接口；密钥只放本地 .env
MINEINTENT_MODEL_BASE_URL=https://你的服务商/v1
MINEINTENT_MODEL_API_KEY=只放在本地
MINEINTENT_MODEL=你的模型名
# 可选值：low、medium、high
# MINEINTENT_MODEL_REASONING_EFFORT=medium
MINEINTENT_AGENT_SERVICE_PORT=8765
